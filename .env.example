SKILLHUB_DATABASE_URL=postgresql+psycopg://postgres@127.0.0.1:5432/skillhub
SKILLHUB_TEST_DATABASE_URL=postgresql+psycopg://postgres@127.0.0.1:5432/skillhub_test
SKILLHUB_HOST=127.0.0.1
SKILLHUB_API_PORT=8000
SKILLHUB_WEB_PORT=3030
VITE_SKILLHUB_API_PORT=8000
VITE_OPENCODE_RUN_POLL_INTERVAL_MS=5000
VITE_SKILLHUB_EVALUATIONS_VISIBLE=true
SKILLHUB_ADMIN_CONSOLE_KEY=
# MCP 本轮只检查非空 Cookie 并模拟 product-operator；此 URL 仅预留，不发起请求。
SKILLHUB_MCP_USERINFO_URL=
# 远程部署额外允许的 Host / Origin，逗号分隔；本机地址始终保留。
# 例如 skillhub.example.com,skillhub.example.com:* 与 https://skillhub.example.com
SKILLHUB_MCP_ALLOWED_HOSTS=
SKILLHUB_MCP_ALLOWED_ORIGINS=
# MCP 结果中的前端工作流链接。
SKILLHUB_WEB_BASE_URL=http://127.0.0.1:3030
SKILLHUB_LOG_LEVEL=INFO
SKILLHUB_DATABASE_CONNECT_TIMEOUT_SECONDS=10
SKILLHUB_DATABASE_STATEMENT_TIMEOUT_MS=30000
SKILLHUB_DATABASE_LOCK_TIMEOUT_MS=5000

OPENCODE_BASE_URL=http://127.0.0.1:4096
WORKFLOW_EXECUTOR_BASE_URL=
WORKFLOW_EXECUTOR_REQUEST_TIMEOUT_SECONDS=10
WORKFLOW_DEBUG_POLL_INTERVAL_SECONDS=2
WORKFLOW_DEBUG_MAX_DURATION_SECONDS=300
EVAL_WORKDIR_HOST=.data/eval-runs
EVAL_WORKDIR_CONTAINER=/workspace/eval-runs
EVAL_RUNNER_TIMEOUT_SECONDS=300
EVAL_RUNNER_MAX_ATTEMPTS=2
EVAL_RUNNER_WORKER_ID=opencode-worker
WORKER_JOB_STALE_AFTER_SECONDS=360
PUBLISH_RELEASE_TIMEOUT_SECONDS=120
SKILL_BUILDER_STALE_AFTER_SECONDS=600

LMNR_BASE_URL=https://api.lmnr.ai
LMNR_HTTP_PORT=
LMNR_PROJECT_API_KEY=
OPENCODE_LMNR_BASE_URL=https://api.lmnr.ai
OPENCODE_LMNR_GRPC_PORT=
LAMINAR_EVAL_SYNC_INTERVAL_MS=5000
